# Copy to .env and adjust. Never commit a real .env.

# Shared HMAC secret agreed with the sender (min 16 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=replace-with-a-long-random-secret

# SQLite for local development; PostgreSQL for anything shared/production.
DATABASE_URL=sqlite:///./webhook.db
# DATABASE_URL=postgresql+psycopg://webhooks:webhooks@localhost:5432/webhooks

# Celery broker. Redis (docker compose) is the default; the SQLAlchemy broker
# needs no extra services and is handy for a quick local run.
CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=sqla+sqlite:///./celery-broker.db
CELERY_TASK_ALWAYS_EAGER=false

# Retry policy: 1 attempt + MAX_RETRIES retries, exponential backoff with jitter.
MAX_RETRIES=5
RETRY_BACKOFF_BASE_SECONDS=2
RETRY_BACKOFF_MAX_SECONDS=300
PROCESSING_LEASE_SECONDS=300

# Sweeper (celery beat) re-enqueues events whose queue message was lost.
SWEEPER_INTERVAL_SECONDS=60
SWEEPER_GRACE_SECONDS=120
SWEEPER_BATCH_SIZE=500

# Simulated downstream service: probability (0..1) of a transient failure.
DOWNSTREAM_FAILURE_RATE=0.2
DOWNSTREAM_LATENCY_SECONDS=0.05

MAX_BODY_BYTES=65536
LOG_LEVEL=INFO
